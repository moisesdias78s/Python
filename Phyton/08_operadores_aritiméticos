adicao = 10 + 10 
print('Adição', adicao)

subtracao = 10 - 10 
print('subtração', subtracao)

multiplicacao = 10 * 10 
print('Multiplicação', multiplicacao)

divisao = 10 / 2.2 #float
print('divisão', divisao)

divisao_inteira = 10 // 2.2
print('Divisão inteira', divisao_inteira)

exponencicacao = 2 ** 10 
print('Exponenciação', exponencicacao)

modulo = 25 % 5 # resto da divisão 
print("Módulo", modulo)

print(10 % 8 == 0)
print(16 % 8 == 0)

concatenacao = 'A' + 'B' + 'C'
print(concatenacao)

a_dez_vezes = 'A' * 10 
